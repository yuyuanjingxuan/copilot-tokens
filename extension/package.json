{
  "name": "copilot-tokens",
  "displayName": "Copilot Tokens",
  "description": "Token usage tracker for VS Code Copilot Chat — parses built-in debug logs and shows per-session input/output tokens, models, latency, and a daily usage chart.",
  "version": "0.2.0",
  "publisher": "yuyuanjingxuan",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuyuanjingxuan/copilot-tokens.git"
  },
  "homepage": "https://github.com/yuyuanjingxuan/copilot-tokens",
  "galleryBanner": {
    "color": "#1e293b",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotTokens",
          "title": "Copilot Tokens",
          "icon": "activitybar.png"
        }
      ]
    },
    "views": {
      "copilotTokens": [
        {
          "type": "webview",
          "id": "copilotTokens.view",
          "name": "Token Usage"
        }
      ]
    },
    "commands": [
      {
        "command": "copilotTokens.show",
        "title": "Copilot Tokens: Show Usage"
      },
      {
        "command": "copilotTokens.refresh",
        "title": "Copilot Tokens: Refresh"
      },
      {
        "command": "copilotTokens.exportJson",
        "title": "Copilot Tokens: Export JSON"
      }
    ],
    "configuration": {
      "title": "Copilot Tokens",
      "properties": {
        "copilotTokens.days": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "description": "Default number of days to include when showing usage."
        },
        "copilotTokens.autoRefresh": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Auto-refresh interval in seconds. Set to 0 to disable auto-refresh."
        },
        "copilotTokens.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "description": "UI language. 'auto' follows the VS Code display language."
        },
        "copilotTokens.theme": {
          "type": "string",
          "enum": [
            "default",
            "green",
            "purple",
            "orange",
            "red"
          ],
          "default": "default",
          "description": "Accent color theme for the usage panel."
        },
        "copilotTokens.chartType": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "area"
          ],
          "default": "bar",
          "description": "Chart type for the daily usage chart."
        },
        "copilotTokens.chartMetric": {
          "type": "string",
          "enum": [
            "total",
            "stacked",
            "requests"
          ],
          "default": "total",
          "description": "Metric shown in the daily usage chart."
        },
        "copilotTokens.chartLogScale": {
          "type": "boolean",
          "default": false,
          "description": "Use a logarithmic y-axis for the daily usage chart (makes small values visible next to large ones)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
